# Copy this file to .env and fill in your values.
# Register your OAuth2 app at: https://www.meetup.com/api/oauth/list/

MEETUP_CLIENT_ID=your_client_id_here
MEETUP_CLIENT_SECRET=your_client_secret_here

# Optional — defaults to http://127.0.0.1:8080/callback
# Must match the redirect URI registered in the Meetup developer console.
MEETUP_REDIRECT_URI=http://127.0.0.1:8080/callback
